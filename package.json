{
  "name": "studiolive-midi-controller",
  "version": "1.7.0",
  "description": "MIDI controller for PreSonus StudioLive mixers using Logic Pro",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.main.json && npm run copy-assets",
    "copy-assets": "mkdir -p dist/renderer && cp src/renderer/index.html dist/renderer/ && node -e \"const fs=require('fs'),p='dist/renderer/index.html',v=require('./package.json').version;fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/id=\\\"status-version\\\">[^<]*/,'id=\\\"status-version\\\">'+v))\" && mkdir -p dist/renderer/icons && cp assets/icons/*.svg assets/icons/*.png dist/renderer/icons/ 2>/dev/null || true && mkdir -p dist/assets && cp assets/icon.icns assets/icon.png dist/assets/ 2>/dev/null || true",
    "start": "electron .",
    "clean": "rm -rf dist",
    "dist": "npm run build && electron-builder",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:soak": "node --expose-gc node_modules/jest/bin/jest.js --config jest.soak.config.js --runInBand",
    "typecheck": "tsc -p tsconfig.main.json --noEmit",
    "shots": "npm run build && node tools/screenshot/run.js"
  },
  "build": {
    "appId": "com.sandinak.studiolive-midi-controller",
    "productName": "StudioLive MIDI Controller",
    "icon": "assets/icon.icns",
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "StudioLive MIDI Controller",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StudioLive MIDI Controller"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "AudioVideo",
      "synopsis": "MIDI control for PreSonus StudioLive III mixers",
      "description": "Map DAW faders and automation to a PreSonus StudioLive III mixer over the network.",
      "desktop": {
        "entry": {
          "StartupWMClass": "studiolive-midi-controller",
          "Keywords": "midi;mixer;audio;presonus;studiolive;"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "maintainer": "sandinak <sandinak@users.noreply.github.com>"
    },
    "deb": {
      "depends": [
        "libasound2 | libasound2t64",
        "libgtk-3-0 | libgtk-3-0t64",
        "libnss3",
        "libxtst6",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "xdg-utils"
      ]
    },
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/@julusian/midi/**",
      "**/node_modules/dtrace-provider/**"
    ],
    "files": [
      "dist/**/*",
      "package.json",
      "CHANGELOG.md",
      "docs/**/*",
      "!**/.claude/**",
      "!**/src/**",
      "!**/tests/**",
      "!**/*.ts",
      "!**/.env",
      "!**/Makefile",
      "!**/.git/**",
      "!**/.*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "keywords": [
    "presonus",
    "studiolive",
    "midi",
    "logic-pro",
    "mixer",
    "controller"
  ],
  "author": "sandinak",
  "homepage": "https://github.com/sandinak/studiolive-midi-controller",
  "license": "MIT",
  "dependencies": {
    "easymidi": "^3.0.1",
    "presonus-studiolive-api": "git+https://github.com/sandinak/presonus-studiolive-api.git#v1.10.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^26.4.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.3"
  }
}
